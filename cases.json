    {
      "id": "server_chaining_top_customer_email",
      "type": "multi_call_chain",
      "category": "server_chaining",
      "prompt": "The shop database has `customers` (id, name, email) and `orders` (id, customer_id, total_cents). Find the customer whose orders add up to the highest total, then save only their email address, nothing else, to ${notes}/top_customer.txt.",
      "mcp_servers": {
        "shop": {
          "kind": "sqlite",
          "fixture": "orders.sql",
          "tools": [
            "read_query"
          ]
        },
        "notes": {
          "kind": "filesystem",
          "fixture": "notes",
          "tools": [
            "write_file"
          ]
        }
      },
      "expected_tool_call": {
        "sequence": [
          {
            "name": "shop__read_query",
            "args": {
              "query": "SELECT c.email FROM customers c JOIN orders o ON o.customer_id = c.id GROUP BY c.id ORDER BY SUM(o.total_cents) DESC LIMIT 1"
            },
            "loose_args": [
              "query"
            ]
          },
          {
            "name": "notes__write_file",
            "args": {
              "path": "${notes}/top_customer.txt",
              "content": "edsger@example.com"
            }
          }
        ]
      }
    },
    {
      "id": "server_chaining_ticket_lookup",
      "type": "multi_call_chain",
      "category": "server_chaining",
      "prompt": "Read ${inbox}/request.txt, look up in the shop database (`customers` has id, name, email) what it asks for, and write only that email address to ${inbox}/reply.txt.",
      "mcp_servers": {
        "inbox": {
          "kind": "filesystem",
          "fixture": "inbox",
          "tools": [
            "read_text_file",
            "write_file"
          ]
        },
        "shop": {
          "kind": "sqlite",
          "fixture": "orders.sql",
          "tools": [
            "read_query"
          ]
        }
      },
      "expected_tool_call": {
        "sequence": [
          {
            "name": "inbox__read_text_file",
            "args": {
              "path": "${inbox}/request.txt"
            }
          },
          {
            "name": "shop__read_query",
            "args": {
              "query": "SELECT email FROM customers WHERE id = 3"
            },
            "loose_args": [
              "query"
            ]
          },
          {
            "name": "inbox__write_file",
            "args": {
              "path": "${inbox}/reply.txt",
              "content": "donald@example.com"
            }
          }
        ]
      }
    },
