        "search_documents",
        "calendar_lookup"
      ],
      "expected_tool_call": null,
      "expected_refusal": {
        "must_mention": [
          "text",
          "content",
          "what",
          "say",
          "wording",
          "message",
          "include"
        ],
        "require_question": true
      }
    },
    {
      "id": "refusal_relative_date",
      "type": "should_refuse",
