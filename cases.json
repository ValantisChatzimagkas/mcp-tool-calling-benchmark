{
  "tools": {
    "calendar_lookup": {
      "type": "function",
      "function": {
        "name": "calendar_lookup",
        "description": "Look up events on a person's calendar for a specific date.",
        "parameters": {
          "type": "object",
          "properties": {
            "person": {
              "type": "string",
              "description": "Email or username of the calendar owner."
            },
            "date": {
              "type": "string",
              "description": "Date to look up, in YYYY-MM-DD format."
            }
          },
          "required": [
            "person",
            "date"
          ]
        }
      }
    },
    "search_documents": {
      "type": "function",
      "function": {
        "name": "search_documents",
        "description": "Full-text search over the team's internal document store. Returns matching documents with their ids.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Search query string."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of results to return."
            }
          },
          "required": [
            "query"
          ]
        }
      }
    },
    "create_task": {
      "type": "function",
      "function": {
        "name": "create_task",
        "description": "Create a task in the team task tracker.",
        "parameters": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Short title of the task."
            },
            "assignee": {
              "type": "string",
              "description": "Username of the person the task is assigned to."
            },
            "due_date": {
              "type": "string",
              "description": "Due date in YYYY-MM-DD format."
            }
          },
          "required": [
            "title",
            "assignee"
          ]
        }
      }
    },
    "send_message": {
      "type": "function",
      "function": {
        "name": "send_message",
        "description": "Send a chat message to a person or channel.",
        "parameters": {
          "type": "object",
          "properties": {
            "recipient": {
              "type": "string",
              "description": "Username or #channel to send to."
            },
            "body": {
              "type": "string",
              "description": "Message text."
            }
          },
          "required": [
            "recipient",
            "body"
          ]
        }
      }
    },
    "search_calendar": {
      "type": "function",
      "function": {
        "name": "search_calendar",
        "description": "Search a person's calendar by keyword across all dates. Use this when the date is unknown; use calendar_lookup when you already know the date.",
        "parameters": {
          "type": "object",
          "properties": {
            "person": {
              "type": "string",
              "description": "Email or username of the calendar owner."
            },
            "query": {
              "type": "string",
              "description": "Keyword to match against event titles."
            }
          },
          "required": [
            "person",
            "query"
          ]
        }
      }
    },
    "update_task": {
      "type": "function",
      "function": {
        "name": "update_task",
        "description": "Update an existing task in the tracker, identified by its task id.",
        "parameters": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "description": "Id of the existing task, e.g. T-8821."
            },
            "status": {
              "type": "string",
              "description": "New status: open, in_progress, or closed."
            },
            "assignee": {
              "type": "string",
              "description": "New assignee username."
            }
          },
          "required": [
            "task_id"
          ]
        }
      }
    },
    "get_document": {
      "type": "function",
      "function": {
        "name": "get_document",
        "description": "Fetch the full contents of a single document by its id. Ids come from search_documents results.",
        "parameters": {
          "type": "object",
          "properties": {
            "document_id": {
              "type": "string",
              "description": "Document id, e.g. doc_114."
            }
          },
          "required": [
            "document_id"
          ]
        }
      }
    },
    "create_reminder": {
      "type": "function",
      "function": {
        "name": "create_reminder",
        "description": "Set a personal reminder for yourself at a given time. For work assigned to another person, use create_task instead.",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "What to be reminded about."
            },
            "remind_at": {
              "type": "string",
              "description": "When, in YYYY-MM-DD format."
            }
          },
          "required": [
            "text"
          ]
        }
      }
    }
  },
  "cases": [
    {
      "id": "selection_search_vs_lookup",
      "type": "single_call",
      "category": "selection",
      "prompt": "Maria has a design review booked sometime this year but I don't know which day. Find it.",
      "available_tools": [
        "search_calendar",
        "calendar_lookup",
        "search_documents"
      ],
      "expected_tool_call": {
        "name": "search_calendar",
        "args": {
          "person": "maria",
          "query": "design review"
        },
        "loose_args": [
          "query"
        ]
      }
    },
    {
      "id": "selection_update_vs_create",
      "type": "single_call",
      "category": "selection",
      "prompt": "Task T-8821 is finished — mark it closed.",
      "available_tools": [
        "update_task",
        "create_task",
        "search_documents"
      ],
      "expected_tool_call": {
        "name": "update_task",
        "args": {
          "task_id": "T-8821",
          "status": "closed"
        }
      }
    },
    {
