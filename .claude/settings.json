{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(uv run run_eval.py:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv sync:*)",
      "Read(cases.json)",
      "Read(results.csv)",
      "Read(results.md)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  },
  "model": "sonnet"
}
