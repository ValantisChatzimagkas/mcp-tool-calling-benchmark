GROQ_API_KEY=gsk_your_key_here

# Which backend profile to run against: groq (default) or ollama. One switch sets the
# endpoint, key requirement, timeout and call spacing together (see config.py).
# BACKEND=ollama

# Optional: override the profile's base URL (a llama.cpp server, a remote Ollama):
# API_BASE_URL=http://localhost:8080/v1
